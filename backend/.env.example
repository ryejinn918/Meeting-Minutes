APP_ENV=development
APP_NAME=meetflow-api
API_V1_PREFIX=/api/v1
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Supabase. Keep secret values server-side.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_JWT_AUDIENCE=authenticated
# auto: asymmetric JWT uses JWKS; legacy HS256 uses the Auth /user endpoint.
SUPABASE_JWT_MODE=auto
SUPABASE_JWKS_CACHE_SECONDS=600
SUPABASE_STORAGE_BUCKET=meeting-files
MAX_AUDIO_BYTES=52428800
MAX_DOCUMENT_BYTES=10485760
MAX_PDF_PAGES=200
STT_DIRECT_MAX_BYTES=20000000
STT_DIRECT_MAX_SECONDS=300
STT_CHUNK_SECONDS=600
STT_CHUNK_OVERLAP_SECONDS=2
STT_MAX_CHUNKS=24
STT_MAX_AUDIO_SECONDS=14400
OPENAI_API_KEY=
OPENAI_STT_MODEL=gpt-4o-transcribe-diarize
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_TIMEOUT_SECONDS=90
OPENAI_TIMEOUT_PER_AUDIO_SECOND=0.6
OPENAI_TIMEOUT_MAX_SECONDS=420
OPENAI_CONNECT_TIMEOUT_SECONDS=10
OPENAI_WRITE_TIMEOUT_SECONDS=60
OPENAI_MAX_RETRIES=1
FFMPEG_TIMEOUT_SECONDS=120
STT_MODE=mock
OPENROUTER_API_KEY=
# Verified against the OpenRouter model catalog; pin a model instead of using an alias.
OPENROUTER_ANALYSIS_MODEL=deepseek/deepseek-v3.2
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_TIMEOUT_SECONDS=45
OPENROUTER_MAX_RETRIES=1
OPENROUTER_MAX_OUTPUT_TOKENS=2500
AI_MODE=mock
AI_MAX_TRANSCRIPT_CHARS=120000
AI_STALE_JOB_SECONDS=300
GPU_WORKER_TOKEN_HASHES=
GPU_WORKER_LEASE_SECONDS=120
GPU_WORKER_DOWNLOAD_TTL_SECONDS=300
